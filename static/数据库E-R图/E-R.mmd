erDiagram
    USER_INFO ||--o{ CHAT_MESSAGE : "发送/接收消息"
    USER_INFO ||--o{ USER_CONTACT : "拥有"
    USER_INFO ||--o{ GROUP_CONTACT : "加入"
    USER_INFO ||--o{ USER_APPLY_INFO : "发送申请"
    USER_INFO ||--o{ GROUP_APPLY_INFO : "发送群申请"
    USER_INFO ||--o{ CUSTOM_ACCOUNT : "绑定"
    GROUP_INFO ||--o{ GROUP_CONTACT : "包含"
    GROUP_INFO ||--o{ GROUP_APPLY_INFO : "接收申请"
